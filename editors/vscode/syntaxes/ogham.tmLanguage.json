{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ogham",
  "scopeName": "source.ogham",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#keywords" },
    { "include": "#function-keyword" },
    { "include": "#type-annotations" },
    { "include": "#operators" },
    { "include": "#widget-name" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ogham",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ogham",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ogham",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ogham",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ogham",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.ogham",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "booleans": {
      "name": "constant.language.boolean.ogham",
      "match": "\\b(true|false)\\b"
    },
    "keywords": {
      "name": "keyword.control.ogham",
      "match": "\\b(let|state|if|else|return|for|in|match|import|from|log)\\b"
    },
    "function-keyword": {
      "name": "keyword.other.fn.ogham",
      "match": "\\bfn\\b"
    },
    "type-annotations": {
      "name": "storage.type.ogham",
      "match": "(?<=:\\s{0,8})\\b(int|string|float|bool|widget|void)\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.ogham",
          "match": "==|!=|>=|<=|>|<"
        },
        {
          "name": "keyword.operator.logical.ogham",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arrow.ogham",
          "match": "=>"
        },
        {
          "name": "keyword.operator.assignment.ogham",
          "match": "="
        },
        {
          "name": "keyword.operator.spread.ogham",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.range.ogham",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.increment.ogham",
          "match": "\\+\\+"
        },
        {
          "name": "keyword.operator.arithmetic.ogham",
          "match": "[+\\-*/%^]"
        }
      ]
    },
    "widget-name": {
      "match": "\\b([A-Z][a-zA-Z0-9]*)\\s*\\{",
      "captures": {
        "1": { "name": "entity.name.type.widget.ogham" }
      }
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.block.ogham",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.bracket.ogham",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.definition.paren.ogham",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.ogham",
          "match": "[;,]"
        },
        {
          "name": "punctuation.separator.colon.ogham",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.ogham",
          "match": "\\."
        }
      ]
    },
    "identifiers": {
      "name": "variable.other.ogham",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  }
}
