

let page_style = {
  width: "grow",
  height: "grow",
  main_alignment: "center",
  cross_alignment: "center",
  direction: "row",
  padding: 16,
  gap: 16,
  background_color: {
    r: 20,
    g: 20,
    b: 20,
    a: 255,
  },
};

let label = fn (text: string) {
  Flex {
    style: {
      width: "grow",
      height: 24,
    },
    children: [
      Text {
    text: text,
        style: {
          color: {
            r: 255,
            g: 255,
            b: 255,
            a: 255,
          },
        },
      }
    ],
  }
};

let sidebar = fn (children: widget[]) {
  Flex {
    style: {
      width: 340,
      height: "shrink",
      direction: "column",
      gap: 8,
      background_color: {
        r: 32,
        g: 32,
        b: 32,
        a: 255,
      },
      border: {
        width: 2,
        color: {
          r: 150,
          g: 150,
          b: 150,
          a: 255,
        },
        style: "solid",
      },
      padding: 16,
      corner_radius: 12,
    },
    children: children,
  }
};

let sidebar_item = fn (text: string) {
  Flex {
    style: {
      width: "grow",
      height: "shrink",
      padding: 8,
      background_color: {
        r: 26,
        g: 26,
        b: 26,
        a: 255,
      },
      corner_radius: 4,
    },
    children: [
      label(text),
    ],
  }
};

let panel_style = {
  width: "grow",
  height: 400,
  padding: 16,
  main_alignment: "start",
  border: {
    width: 2,
    color: {
      r: 150,
      g: 150,
      b: 150,
      a: 255,
    },
    style: "solid",
  },
  direction: "column",
  corner_radius: 16,
  background_color: {
    r: 40,
    g: 40,
    b: 40,
    a: 255,
  },
};

let panel = fn (children: widget[]) {
  Flex {
    style: panel_style,
    children: children,
  }
};

let main = fn () {
  Flex {
    style: page_style,
    children: [
      sidebar([
        sidebar_item("Option 1"),
        sidebar_item("Option 2"),
        sidebar_item("Option 3"),
      ]),
      panel([
        label("This is a component instance!"),
        label("This is another component instance!"),
        label("This is a third component instance!"),
      ]),
    ],
  }
};